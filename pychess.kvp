Meta.DisplayName=PyChess Variants (TeamKit)
Meta.Description=Site d'echecs et de variantes PyChess Variants (le logiciel libre AGPL-3.0 de pychess.org, non modifie) : echecs, xiangqi, shogi, janggi, makruk, crazyhouse, bughouse et des dizaines d'autres, contre d'autres joueurs ou contre Fairy-Stockfish. Tout tient dans l'instance : Python 3.14, MongoDB 8.0 (socket locale, aucun port), le moteur IA. Les joueurs jouent en invites sans compte, ou se connectent avec Lichess (aucune cle a demander). A mettre derriere nginx en HTTPS sur un sous-domaine (ex. echecs.teamkit.fr). Environ 1,2 Go de RAM avec l'IA, 4,5 Go de disque.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-PyChess
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/pychess/pychess-variants/master/static/images/pychess-variants.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=pychessconfig.json
Meta.MetaConfigManifest=pychessmetaconfig.json
Meta.ConfigRoot=pychess.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=PyChess, MongoDB, Python 3.14, Node.js et le moteur sont installes dans le dossier de l'instance par un script teste dans l'image cubecoders/ampbase:debian (Debian 13) ; la base MongoDB n'ecoute que sur une socket du conteneur.
Meta.ExtraSetupStepsURI=https://github.com/hydrocut/AMPTemplates-PyChess#install-in-amp
